library(shiny)
library(ggplot2)
# 1. UI（画面のデザイン）
ui <- fluidPage(
titlePanel("動的データ追加アプリ"),
sidebarLayout(
sidebarPanel(
# データの入力フォーム
numericInput("num_x", "Xの値を入力:", value = 1),
numericInput("num_y", "Yの値を入力:", value = 5),
actionButton("add_btn", "データを追加", class = "btn-primary"),
hr(),
actionButton("reset_btn", "リセット")
),
mainPanel(
# グラフとデータテーブルの表示
plotOutput("scatter_plot"),
tableOutput("data_table")
)
)
)
# 2. Server（動く仕組み）
server <- function(input, output, session) {
# 追加されるデータを保存する「反応性（Reactive）オブジェクト」を作成
v <- reactiveValues(
data = data.frame(X = numeric(), Y = numeric())
)
# 「データを追加」ボタンが押された時の処理
observeEvent(input$add_btn, {
new_row <- data.frame(X = input$num_x, Y = input$num_y)
v$data <- rbind(v$data, new_row)
})
# 「リセット」ボタンが押された時の処理
observeEvent(input$reset_btn, {
v$data <- data.frame(X = numeric(), Y = numeric())
})
# グラフの描画
output$scatter_plot <- renderPlot({
if (nrow(v$data) == 0) {
# データが空の時は空のプロットを表示
ggplot() +
xlim(0, 10) + ylim(0, 10) +
labs(title = "データがありません。追加してください。")
} else {
# データがある時は散布図を描画
ggplot(v$data, aes(x = X, y = Y)) +
geom_point(color = "blue", size = 4) +
xlim(0, 10) + ylim(0, 10) +
theme_minimal() +
labs(title = "追加されたデータの散散布図")
}
})
# テーブルの表示
output$data_table <- renderTable({
v$data
})
}
# 3. アプリの実行
shinyApp(ui = ui, server = server)
library(shiny)
library(ggplot2)
# 1. UI（画面のデザイン）
ui <- fluidPage(
titlePanel("動的データ追加アプリ"),
sidebarLayout(
sidebarPanel(
# データの入力フォーム
numericInput("num_x", "Xの値を入力:", value = 1),
numericInput("num_y", "Yの値を入力:", value = 5),
# テキスト入力フォーム（ラベル用）を追加
actionButton("add_btn", "データを追加", class = "btn-primary"),
hr(),
actionButton("reset_btn", "リセット")
),
mainPanel(
# グラフとデータテーブルの表示
plotOutput("scatter_plot"),
tableOutput("data_table")
)
)
)
# 2. Server（動く仕組み）
server <- function(input, output, session) {
# 追加されるデータを保存する「反応性（Reactive）オブジェクト」を作成
v <- reactiveValues(
data = data.frame(X = numeric(), Y = numeric())
)
# 「データを追加」ボタンが押された時の処理
observeEvent(input$add_btn, {
new_row <- data.frame(X = input$num_x, Y = input$num_y)
v$data <- rbind(v$data, new_row)
})
# 「リセット」ボタンが押された時の処理
observeEvent(input$reset_btn, {
v$data <- data.frame(X = numeric(), Y = numeric())
})
# グラフの描画
output$scatter_plot <- renderPlot({
if (nrow(v$data) == 0) {
# データが空の時は空のプロットを表示
ggplot() +
xlim(0, 10) + ylim(0, 10) +
labs(title = "データがありません。追加してください。")
} else {
# データがある時は散布図を描画
ggplot(v$data, aes(x = X, y = Y)) +
geom_point(color = "blue", size = 4) +
xlim(0, 10) + ylim(0, 10) +
theme_minimal() +
labs(title = "追加されたデータの散散布図")
}
})
# テーブルの表示
output$data_table <- renderTable({
v$data
})
}
# 3. アプリの実行
shinyApp(ui = ui, server = server)
